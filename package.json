{
  "name": "rgbbox",
  "version": "0.2.0",
  "description": "Local-first desktop RGB lighting controller with multi-display screen sampling.",
  "author": "RGBBox Contributors",
  "homepage": "https://github.com/tjf/RGBBox",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "download-models": "node scripts/download-models.mjs",
    "postinstall": "node scripts/download-models.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/download-models.mjs && yarn typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "dist": "yarn build && electron-builder",
    "dist:win": "yarn build && electron-builder --win",
    "dist:mac": "yarn build && electron-builder --mac",
    "dist:dir": "yarn build && electron-builder --dir"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "@vitejs/plugin-react": "6.0.1",
    "lucide-react": "1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "electron": "41.4.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  },
  "build": {
    "appId": "app.rgbbox.desktop",
    "productName": "RGBBox",
    "copyright": "Copyright © 2025 RGBBox Contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "./assets/models/", "to": "models", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "zip",  "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
