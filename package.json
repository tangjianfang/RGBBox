{
  "name": "rgbbox",
  "version": "0.3.43",
  "description": "Local-first desktop RGB lighting controller with multi-display screen sampling.",
  "author": "RGBBox Contributors",
  "homepage": "https://github.com/tangjianfang/RGBBox",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "download-models": "node scripts/download-models.mjs",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "predist": "npm version patch --no-git-tag-version",
    "predist:clean": "node scripts/dist-clean.mjs",
    "dist": "yarn predist:clean && yarn build && electron-builder",
    "dist:win": "npm version patch --no-git-tag-version && yarn predist:clean && yarn build && electron-builder --win",
    "dist:mac": "npm version patch --no-git-tag-version && yarn predist:clean && yarn build && electron-builder --mac",
    "dist:dir": "npm version patch --no-git-tag-version && yarn predist:clean && yarn build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "@vitejs/plugin-react": "5.2.0",
    "hls.js": "1.5.17",
    "lucide-react": "1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "0.184.0",
    "wavesurfer.js": "^7.12.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "@vitest/coverage-v8": "^4.1.7",
    "electron": "41.4.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "gl": "^8.1.6",
    "happy-dom": "^15.11.7",
    "rcedit": "2",
    "typescript": "6.0.3",
    "vite": "6.4.2",
    "vitest": "4.1.7"
  },
  "build": {
    "appId": "app.rgbbox.desktop",
    "productName": "RGBBox",
    "copyright": "Copyright © 2025 RGBBox Contributors",
    "afterPack": "./scripts/afterPack.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/renderer/assets/models/*.splat",
      "!out/renderer/assets/models/*.ksplat",
      "!out/renderer/assets/models/*.spz",
      "!out/renderer/assets/models/*.ply",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "signtoolOptions": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "sign": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
